[Unit]
Description=Startampel fuer OmegaSim (Bluetooth LE)
After=bluetooth.service
Requires=bluetooth.service

[Service]
# Pfad ggf. anpassen. Laeuft als root: BlueZ-Anmeldung und GPIO.
WorkingDirectory=/home/pi/startampel
ExecStartPre=/usr/sbin/rfkill unblock bluetooth
ExecStart=/usr/bin/python3 /home/pi/startampel/startampel.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
